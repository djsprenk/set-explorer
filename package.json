{
  "name": "dj-analytics",
  "version": "1.0.0",
  "description": "Analytics and visualization for DJ sets",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "sass": "^1.77.6",
    "standard": "^17.1.0",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "scripts": {
    "build": "sass src/stylesheets:dist/stylesheets && webpack --config webpack.config.prod.js",
    "develop": "sass --watch src/stylesheets:dist/stylesheets & webpack serve --open --config webpack.config.dev.js",
    "sass": "sass --watch src/stylesheets:dist/stylesheets",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "npx standard --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsprenkle/dj-analytics.git"
  },
  "keywords": [
    "DJ",
    "data-visualization"
  ],
  "author": "DJ Sprenk",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/nsprenkle/dj-analytics/issues"
  },
  "homepage": "https://github.com/nsprenkle/dj-analytics#readme",
  "dependencies": {
    "d3": "=5.1.0"
  }
}
